generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  name             String?
  image            String?
  emailVerified    DateTime?
  accounts         Account[]
  sessions         Session[]
  profile          Profile?
  interviewSessions InterviewSession[]
  createdAt        DateTime           @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeText    String?  @db.Text
  targetRole    String?
  targetCompany String?
  industry      String?
  experience    String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model InterviewSession {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionType    String
  industry       String?
  companyName    String?
  jobDescription String?    @db.Text
  status         String     @default("in_progress")
  questions      Json?
  responses      Response[]
  createdAt      DateTime   @default(now())
  completedAt    DateTime?
}

model Response {
  id               String           @id @default(cuid())
  sessionId        String
  session          InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionText     String           @db.Text
  questionCategory String?
  transcript       String?          @db.Text
  audioUrl         String?
  durationSeconds  Int?
  feedback         Feedback?
  createdAt        DateTime         @default(now())
}

model Feedback {
  id                   String   @id @default(cuid())
  responseId           String   @unique
  response             Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  overallScore         Int
  contentScore         Int
  deliveryScore        Int
  eyeContactScore      Int
  bodyLanguageScore    Int
  contentFeedback      String   @db.Text
  deliveryFeedback     String   @db.Text
  eyeContactFeedback   String   @db.Text
  bodyLanguageFeedback String   @db.Text
  overallFeedback      String   @db.Text
  modelAnswer          String   @db.Text
  fillerWords          String[]
  missingStarComponents String[]
  resumeAlignmentNotes String?  @db.Text
  createdAt            DateTime @default(now())
}
